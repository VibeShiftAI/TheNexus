# ==============================================================================
# TheNexus Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# ==============================================================================

# --- Server ---
PORT=4000
PROJECT_ROOT=/path/to/your/projects
NEXUS_DB_PATH=/absolute/path/to/TheNexus/nexus.db

# --- AI Provider API Keys (at least 2 required) ---
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
XAI_API_KEY=your-xai-api-key

# --- Internal (auto-generated on first server start if empty) ---
NEXUS_SERVICE_KEY=

# --- Frontend URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CORTEX_URL=http://localhost:8000

# --- Optional: Google Custom Search (for web search tool) ---
# GOOGLE_CSE_ID=your-custom-search-engine-id

# --- Studio ingestion ---
# YouTube Data API v3 key for Studio source ingestion + related-video expansion.
# Falls back to GOOGLE_API_KEY if unset (the YouTube Data API must be enabled on that key's Cloud project).
# YOUTUBE_API_KEY=your-youtube-data-api-key
# Local model used for Studio object extraction + writer/critic (Ollama/LM Studio model name).
# LOCAL_STUDIO_MODEL=gemma4
# Nightly astrophysics agent: set to "off" to disable, or STUDIO_NIGHTLY_HOUR to change the run hour (default 2).
# STUDIO_NIGHTLY=on
# STUDIO_NIGHTLY_HOUR=2
# Backfill/enrichment batch sizes per run. NASA backfill page (200), ArXiv per topic (6),
# objects enriched per run / per "Enrich catalog" click (25). YouTube quota is ~50 enrich/day on the free tier.
# STUDIO_NASA_BATCH=200
# STUDIO_ARXIV_BATCH=6
# STUDIO_ENRICH_BATCH=25
