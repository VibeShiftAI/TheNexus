# ==============================================================================
# TheNexus Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# ==============================================================================

# --- Server ---
PORT=4000
PROJECT_ROOT=/path/to/your/projects
NEXUS_DB_PATH=/absolute/path/to/TheNexus/nexus.db

# --- AI Provider API Keys (at least 2 required) ---
# GOOGLE_API_KEY normally lives ONCE in /Volumes/Projects/.fleet-env (shared with
# Praxis and TheCortex; template /Volumes/Projects/.fleet-env.example), loaded by
# server/utils/fleet-env.js before this file. Set it here only to override locally.
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
XAI_API_KEY=your-xai-api-key

# --- Internal (auto-generated on first server start if empty) ---
NEXUS_SERVICE_KEY=

# --- Frontend URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CORTEX_URL=http://localhost:8100

# --- Optional: Google Custom Search (for web search tool) ---
# GOOGLE_CSE_ID=your-custom-search-engine-id

# --- Studio ingestion ---
# YouTube Data API v3 key for Studio source ingestion + related-video expansion.
# Falls back to GOOGLE_API_KEY if unset (the YouTube Data API must be enabled on that key's Cloud project).
# YOUTUBE_API_KEY=your-youtube-data-api-key
# Studio's local calls (object extraction, writer/critic) use the local model chosen
# under Model Control. LOCAL_STUDIO_MODEL (then LOCAL_LLM_MODEL) is only the fallback
# when the local_default alias names no active local model; the log says when it is used.
# LOCAL_STUDIO_MODEL=gemma4
# Nightly astrophysics agent: set to "off" to disable, or STUDIO_NIGHTLY_HOUR to change the run hour (default 2).
# STUDIO_NIGHTLY=on
# STUDIO_NIGHTLY_HOUR=2
# Backfill/enrichment batch sizes per run. NASA backfill page (200), ArXiv per topic (6),
# objects enriched per run / per "Enrich catalog" click (25). YouTube quota is ~50 enrich/day on the free tier.
# STUDIO_NASA_BATCH=200
# STUDIO_ARXIV_BATCH=6
# STUDIO_ENRICH_BATCH=25

# --- Reserved stakeholder approvals and document decisions ---
# Real values must come from the supervisor/secret store, not this file.
# Use distinct secrets of at least 32 characters each; a key equal to another is
# refused for both roles. All three live in /Volumes/Projects/.fleet-env (loaded first).
# The operator key is Robert's own authority: stakeholder approvals and direct document
# decisions; no executor holds it. The document key is the document-scoped executor
# credential: a dispatched executor uses it only through scripts/record-document-approval.js
# to record Robert's "approve with changes" review on the resulting revision, citing the
# review he finished with the approve-after-changes grant; stakeholder endpoints refuse it
# (docs/contracts/document-review-deliverables.md, section 6).
# NEXUS_OPERATOR_APPROVAL_KEY=
# NEXUS_DOCUMENT_APPROVAL_KEY=
# NEXUS_STAKEHOLDER_RUNTIME_KEY=

# --- Authenticated primary chat (operator restart authority) ---
# Public verification configuration, not client credentials. Set the exact Access
# team issuer, Nexus application AUD tag, and Robert's IdP-verified email.
# Only requests with a verified Cf-Access-Jwt-Assertion receive restart authority.
# Local/unsigned chat stays usable but has no operator grant. No key is sent to UI.
# NEXUS_OPERATOR_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# NEXUS_OPERATOR_ACCESS_AUD=
# NEXUS_OPERATOR_EMAIL=
# Optional trusted devices: the Windows travel shell signs in to Access with a
# service token instead of a person, so its chat turns carry that token's
# Client ID (`<32 hex>.access`, the JWT common_name) and no email. List the
# Client IDs to trust, comma or space separated; each verified turn is logged as
# identity=device. Never put a Client Secret here. Reload Nexus after a change.
# NEXUS_OPERATOR_DEVICE_IDS=
# PRAXIS_OPERATOR_KEY is the separate Nexus->Praxis signing secret, loaded from
# the protected fleet environment by both daemons; never put it in frontend code.
