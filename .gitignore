desktop/updates/

# Rust/Cargo build output (Tauri) — build locally, never commit
target/

# Neo4j data files
docker/data/neo4j_data/

# SQLite databases and temp files
*.db
*.db-shm
*.db-wal
*.db.*
*.sqlite
*.sqlite3

# DB backups / snapshots (timestamped names slip past *.db)
backups/

# Blackboard session data
data/blackboard/

# Studio reference-image scratch — the studio-route test suite uploads a
# throwaway `fake-png-bytes` blob that server/routes/studio.js persists here
# on every `npx jest` run and never cleans up. These are invalid test
# artifacts, not real references; keep new ones out of the working tree.
# (Root-cause follow-up: studio-route.test.js should unlink its upload.)
data/studio-references/

