<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thenexus.langgraph</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>while [ ! -d /Volumes/Projects/TheNexus/nexus-builder ]; do sleep 5; done; cd /Volumes/Projects/TheNexus/nexus-builder &amp;&amp; export PYTHONPATH="/Volumes/Projects/TheNexus:/Volumes/Projects/TheNexus/nexus-builder/venv/lib/python3.13/site-packages" &amp;&amp; export NEXUS_YOUTUBE_LIVE_ENABLED=1 &amp;&amp; exec /opt/homebrew/opt/python@3.13/bin/python3.13 -m uvicorn main:app --port 8000</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>NEXUS_YOUTUBE_LIVE_ENABLED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/nexus-langgraph-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/nexus-langgraph-stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
