# @praxis/contract is the sibling checkout ../../nexus-shared. Install `file:`
# dependencies as real copies instead of symlinks: turbopack resolves symlinks
# to their real path and refuses modules outside the project root (this repo),
# which took every dashboard page down on 2026-09-03. The copy carries the
# contract's own zod 3 dependency, so it never picks up the root's zod 4.
# npm does not refresh an installed copy on a plain `npm install`: after a
# contract change run `npm run build` in nexus-shared, then here run
# `rm -rf node_modules/@praxis && npm install` (or `npm ci`).
install-links=true
