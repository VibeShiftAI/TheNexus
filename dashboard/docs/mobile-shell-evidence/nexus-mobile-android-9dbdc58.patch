@@ -0,0 +1,205 @@
+/**
+ * Dashboard shell — route mapping and navigation policy.
+ *
+ * The Android app is a thin shell around the canonical Nexus dashboard: one
+ * WebView pointed at the configured server URL. Everything in this module is a
+ * pure function so the policy that decides what the WebView may load, and how
+ * the retired native routes map onto dashboard pages, is unit-tested and
+ * auditable in one place. See docs/dashboard-shell.md.
+ */
+
+/** The single native screen that hosts the dashboard (app/shell.tsx). */
+export const SHELL_ROUTE = '/shell' as const;
+
+/** What the shell does with a URL the WebView wants to load. */
+export type NavigationKind =
+  /** On the configured dashboard origin: render it. */
+  | 'trusted'
+  /** Cloudflare Access login for that origin: render only as an explicit, user-chosen fallback. */
+  | 'access-login'
+  /** Any other http(s) URL: hand to the system browser. */
+  | 'external'
+  /** mailto:, tel:, sms: — hand to the matching system app. */
+  | 'handoff'
+  /** Anything else (javascript:, data:, intent:, file:, blob: …): refuse. */
+  | 'blocked';
+
+const ORIGIN_RE = /^(https?):\/\/([^/?#\s\\]+)/i;
+const HANDOFF_RE = /^(mailto|tel|sms):/i;
+// eslint-disable-next-line no-control-regex
+const CONTROL_CHARS_RE = /[\x00-\x1f\x7f]/;
+
+/**
+ * `scheme://host[:port]` of an http(s) URL, lower-cased, default port dropped;
+ * null for anything else. URLs with userinfo ("user@host") are rejected
+ * outright — that shape exists mainly to spoof origins.
+ */
+export function originOf(url: string | null | undefined): string | null {
+  if (typeof url !== 'string') return null;
+  const match = ORIGIN_RE.exec(url.trim());
+  if (!match) return null;
+  const scheme = match[1].toLowerCase();
+  let authority = match[2].toLowerCase();
+  if (authority.includes('@')) return null;
+  if ((scheme === 'https' && authority.endsWith(':443')) || (scheme === 'http' && authority.endsWith(':80'))) {
+    authority = authority.slice(0, authority.lastIndexOf(':'));
+  }
+  return `${scheme}://${authority}`;
+}
+
+/** Host name (no port) of an http(s) URL, or null. IPv6 literals keep their brackets. */
+export function hostOf(url: string | null | undefined): string | null {
+  const origin = originOf(url);
+  if (!origin) return null;
+  const authority = origin.slice(origin.indexOf('://') + 3);
+  if (authority.startsWith('[')) return authority.slice(0, authority.indexOf(']') + 1);
+  return authority.split(':')[0];
+}
+
+export function isCloudflareAccessHost(host: string | null): boolean {
+  return !!host && (host === 'cloudflareaccess.com' || host.endsWith('.cloudflareaccess.com'));
+}
+
+export function classifyNavigation(url: string, trustedOrigin: string): NavigationKind {
+  if (HANDOFF_RE.test(url.trim())) return 'handoff';
+  const origin = originOf(url);
+  if (!origin) return 'blocked';
+  if (origin === trustedOrigin) return 'trusted';
+  if (isCloudflareAccessHost(hostOf(url))) return 'access-login';
+  return 'external';
+}
+
+/**
+ * A dashboard path is an absolute path on the dashboard origin
+ * ("/task/abc?x=1#y"). Anything that could escape the origin — a scheme, a
+ * protocol-relative "//host", a backslash trick, control characters — or that
+ * is simply not a string collapses to the bridge home. Raw spaces and
+ * non-ASCII are percent-encoded; already-encoded sequences are left alone.
+ */
+export function sanitizeDashboardPath(input: unknown): string {
+  if (typeof input !== 'string') return '/';
+  const path = input.trim();
+  if (!path.startsWith('/')) return '/';
+  if (path.startsWith('//') || path.startsWith('/\\')) return '/';
+  if (CONTROL_CHARS_RE.test(path)) return '/';
+  if (path.length > 2048) return '/';
+  // A colon in the path segment is never a dashboard route; it is how "nexus://https://…" tries to smuggle a URL in.
+  if (path.split(/[?#]/, 1)[0].includes(':')) return '/';
+  return path.replace(/[^\x21-\x7e]/g, (c) => encodeURIComponent(c));
+}
+
+export type ParamValue = string | string[] | undefined;
+export type RouteParams = Record<string, ParamValue>;
+
+/** First non-empty string of an expo-router param (they may arrive as arrays). */
+export function firstParam(value: ParamValue): string | undefined {
+  if (Array.isArray(value)) return value.find((v) => typeof v === 'string' && v.length > 0);
+  return typeof value === 'string' && value.length > 0 ? value : undefined;
+}
+
+/** Strip expo-router group segments: "/(tabs)/inbox" → "/inbox". */
+export function stripRouteGroups(pathname: string): string {
+  const stripped = pathname.replace(/\/\([^/]*\)(?=\/|$)/g, '');
+  return stripped === '' ? '/' : stripped;
+}
+
+/**
+ * The native screens this app used to have, mapped onto the dashboard routes
+ * that serve the same purpose. Praxis push payloads still name
+ * '/(tabs)/inbox' and '/(tabs)/praxis', and older nexus:// links were minted
+ * against this screen set, so both keep working through this table.
+ */
+const LEGACY_NATIVE_ROUTES: Readonly<Record<string, string>> = {
+  '/': '/',
+  '/index': '/',
+  '/tasks': '/task-board',
+  '/inbox': '/inbox',
+  '/praxis': '/', // Praxis chat is the bridge main viewer
+  '/notes': '/', // the scratchpad is a bridge header control
+  '/system': '/system-monitor',
+  '/council': '/council',
+  '/calendar': '/calendar',
+  '/dispatch': '/ops',
+  '/reports': '/activity',
+  '/revenue': '/', // LARS opens from the bridge menu (external dashboard)
+};
+
+/** Dashboard path that replaces a native route + params; unknown routes pass through for the dashboard to resolve. */
+export function dashboardPathForNativeRoute(pathname: string, params: RouteParams = {}): string {
+  let path = stripRouteGroups(sanitizeDashboardPath(pathname));
+  if (path.length > 1 && path.endsWith('/')) path = path.slice(0, -1);
+  if (path === '/inbox') {
+    const hitlId = firstParam(params.hitlId) ?? firstParam(params.hitl_id) ?? firstParam(params.id);
+    return hitlId ? `/inbox#${encodeURIComponent(hitlId)}` : '/inbox';
+  }
+  if (Object.prototype.hasOwnProperty.call(LEGACY_NATIVE_ROUTES, path)) return LEGACY_NATIVE_ROUTES[path];
+  const task = /^\/task\/([^/?#]+)$/.exec(path);
+  if (task) return `/task/${task[1]}`;
+  const project = /^\/project\/([^/?#]+)$/.exec(path);
+  if (project) return `/project/${project[1]}`;
+  if (path.startsWith('/report/')) return '/activity';
+  return path;
+}
+
+export type ShellHref = { pathname: typeof SHELL_ROUTE; params: { path: string; n: string } };
+
+/**
+ * expo-router href that shows `path` in the shell. `n` is a nonce: the shell
+ * screen is a singleton whose params are updated in place, so two requests
+ * for the same path in a row still need to look different to be re-applied.
+ */
+export function shellHref(path: string, nonce: number = Date.now()): ShellHref {
+  return { pathname: SHELL_ROUTE, params: { path: sanitizeDashboardPath(path), n: String(nonce) } };
+}
+
+export function shellHrefForNativeRoute(pathname: string, params: RouteParams = {}, nonce?: number): ShellHref {
+  return shellHref(dashboardPathForNativeRoute(pathname, params), nonce);
+}
+
+function decodeSafe(value: string): string {
+  try {
+    return decodeURIComponent(value.replace(/\+/g, ' '));
+  } catch {
+    return value;
+  }
+}
+
+/**
+ * Rewrite an incoming system URL so links minted for the old native screens
+ * land in the shell showing the equivalent dashboard page. Handles the app's
+ * own nexus:// scheme and plain http(s) links; every other scheme (the
+ * exp+nexus-mobile:// dev-client links, Expo Go's exp://) passes through
+ * untouched, as do links that already target /shell or /settings.
+ */
+export function rewriteSystemPath(incoming: string): string {
+  if (typeof incoming !== 'string') return incoming;
+  const match = /^([a-z][a-z0-9+.-]*):\/\/([^/?#]*)(.*)$/is.exec(incoming.trim());
+  const scheme = match ? match[1].toLowerCase() : null;
+  if (scheme && scheme !== 'nexus' && scheme !== 'http' && scheme !== 'https') return incoming;
+
+  // nexus://inbox?x=1 puts "inbox" where a host would be; http(s) links carry a real host.
+  let rest = match ? (scheme === 'nexus' ? `/${match[2]}${match[3]}` : match[3]) : incoming;
+  rest = rest.replace(/^\/--\//, '/');
+  if (!rest.startsWith('/')) rest = `/${rest}`;
+
+  const hashIndex = rest.indexOf('#');
+  const hash = hashIndex >= 0 ? rest.slice(hashIndex) : '';
+  const beforeHash = hashIndex >= 0 ? rest.slice(0, hashIndex) : rest;
+  const queryIndex = beforeHash.indexOf('?');
+  const pathname = queryIndex >= 0 ? beforeHash.slice(0, queryIndex) : beforeHash;
+  const query = queryIndex >= 0 ? beforeHash.slice(queryIndex + 1) : '';
+  if (pathname === '/settings' || pathname === SHELL_ROUTE) return incoming;
+
+  const params: RouteParams = {};
+  for (const pair of query.split('&')) {
+    if (!pair) continue;
+    const eq = pair.indexOf('=');
+    params[decodeSafe(eq >= 0 ? pair.slice(0, eq) : pair)] = decodeSafe(eq >= 0 ? pair.slice(eq + 1) : '');
+  }
+  const mapped = dashboardPathForNativeRoute(pathname, params);
+  const passThrough = mapped === stripRouteGroups(pathname);
+  let target = mapped;
+  if (passThrough && query && !target.includes('?')) target += `?${query}`;
+  if (hash && !target.includes('#')) target += hash;
+  return `nexus://shell?path=${encodeURIComponent(sanitizeDashboardPath(target))}`;
+}
