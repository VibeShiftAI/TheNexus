+    });
+    await screen.findByTestId('shell-overlay-page-error');
+    expect(screen.getByText('The dashboard failed to load')).toBeTruthy();
+
+    fireEvent.press(screen.getByTestId('shell-retry'));
+    expect(mockReload).toHaveBeenCalledTimes(1);
+  });
+});
