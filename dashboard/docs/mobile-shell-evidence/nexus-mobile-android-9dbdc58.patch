+/**
+ * Incoming system links (nexus://…, http(s) links routed to the app) are
+ * rewritten so links minted for the retired native screens land in the shell
+ * showing the equivalent dashboard page. Dev-client and Expo Go links pass
+ * through untouched. The pure logic lives in lib/shell/routes.ts
+ * (rewriteSystemPath) where it is unit-tested.
+ */
+import { rewriteSystemPath } from '@/lib/shell/routes';
+
+export function redirectSystemPath({ path }: { path: string; initial: boolean }): string {
+  try {
+    return rewriteSystemPath(path);
+  } catch {
+    return path;
+  }
+}
