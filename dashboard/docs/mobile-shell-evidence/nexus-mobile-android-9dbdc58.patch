+++ b/lib/shell/session.ts
@@ -0,0 +1,85 @@
+/**
+ * Dashboard shell — Cloudflare Access session priming.
+ *
+ * The hosted Nexus (https://nexus.vibeshiftai.com) sits behind Cloudflare
+ * Access. The phone holds a Service Auth token (CF-Access-Client-Id / Secret
+ * in SecureStore), but a WebView cannot attach headers to every request the
+ * dashboard makes. So, exactly like the desktop travel shell
+ * (TheNexus/desktop/src-tauri/src/main.rs), the app trades the token for a
+ * `CF_Authorization` session cookie with ONE native request: React Native's
+ * Android networking stores response cookies in the WebView's CookieManager
+ * (ForwardingCookieHandler), so from then on the WebView carries the session
+ * on every request it makes — page loads, /api/* fetches, Socket.IO and SSE.
+ * The credentials themselves never enter web content.
+ *
+ * The same request doubles as the reachability check: it tells apart a
+ * server that is down, a token Access refuses, and a backend that is broken.
+ */
+import { getMediaAuthHeaders } from '@/lib/auth';
+import { hostOf, isCloudflareAccessHost } from './routes';
+
+export type PrimeFailure = 'not-configured' | 'access-denied' | 'unreachable' | 'server-error';
+
+export type PrimeResult =
+  | { ok: true; host: string }
+  | { ok: false; reason: PrimeFailure; detail: string; status?: number };
+
+/** Small JSON endpoint on the API side of the tunnel (routed to :4000, no auth of its own). */
+export const HEALTH_PATH = '/api/health';
+
+export const DEFAULT_PRIME_TIMEOUT_MS = 12_000;
+
+export async function primeDashboardSession(
+  serverUrl: string | null | undefined,
+  timeoutMs: number = DEFAULT_PRIME_TIMEOUT_MS,
+): Promise<PrimeResult> {
+  const host = hostOf(serverUrl);
+  if (!serverUrl || !host) {
+    return { ok: false, reason: 'not-configured', detail: 'No Nexus server URL is configured.' };
+  }
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const headers = await getMediaAuthHeaders();
+    const response = await fetch(`${serverUrl.replace(/\/+$/, '')}${HEALTH_PATH}`, {
+      method: 'GET',
+      headers: { ...headers, Accept: 'application/json' },
+      signal: controller.signal,
+    });
+    const landedOn = hostOf(response.url) ?? host;
+    if (isCloudflareAccessHost(landedOn)) {
+      return {
+        ok: false,
+        reason: 'access-denied',
+        detail: 'Cloudflare Access sent the request to its login page: the service token is missing, wrong, or not allowed by the Access policy for this app.',
+        status: response.status,
+      };
+    }
+    if (response.status === 401 || response.status === 403) {
+      return { ok: false, reason: 'access-denied', detail: `${host} refused the credentials (HTTP ${response.status}).`, status: response.status };
+    }
+    const contentType = response.headers.get('content-type') ?? '';
+    if (response.ok && /json/i.test(contentType)) {
+      return { ok: true, host };
+    }
+    if (response.ok) {
+      return {
+        ok: false,
+        reason: 'access-denied',
+        detail: `${host} answered ${contentType || 'a non-JSON response'} instead of the health check — usually an Access login page.`,
+        status: response.status,
+      };
+    }
+    return { ok: false, reason: 'server-error', detail: `${host} answered HTTP ${response.status} for ${HEALTH_PATH}.`, status: response.status };
+  } catch (error) {
+    const timedOut = error instanceof Error && error.name === 'AbortError';
+    const message = error instanceof Error ? error.message : String(error);
+    return {
+      ok: false,
+      reason: 'unreachable',
+      detail: timedOut ? `${host} did not answer within ${Math.round(timeoutMs / 1000)}s.` : `Could not reach ${host}: ${message}`,
+    };
+  } finally {
+    clearTimeout(timer);
+  }
+}
