--- /dev/null
+++ b/app/shell.tsx
@@ -0,0 +1,23 @@
+/**
+ * /shell — the app's one real screen: the canonical Nexus dashboard, hosted.
+ *
+ * Params: `path` (dashboard path to show, e.g. "/inbox#hitl-id") and `n`, a
+ * nonce that makes repeated requests for the same path distinguishable. Both
+ * are optional; the bridge home is the default.
+ */
+import { Stack, useLocalSearchParams } from 'expo-router';
+
+import { DashboardShell } from '@/components/shell/dashboard-shell';
+import { firstParam, sanitizeDashboardPath } from '@/lib/shell/routes';
+
+export default function ShellScreen() {
+  const params = useLocalSearchParams<{ path?: string | string[]; n?: string | string[] }>();
+  const path = sanitizeDashboardPath(firstParam(params.path) ?? '/');
+  const nonce = firstParam(params.n);
+  return (
+    <>
+      <Stack.Screen options={{ headerShown: false, animation: 'none' }} />
+      <DashboardShell path={path} nonce={nonce} />
+    </>
+  );
+}
