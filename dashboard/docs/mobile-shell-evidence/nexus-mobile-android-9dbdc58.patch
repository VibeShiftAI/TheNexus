+} from './routes';
+
+const ORIGIN = 'https://nexus.vibeshiftai.com';
+
+describe('originOf / hostOf', () => {
+  it('normalises scheme, host case and default ports', () => {
+    expect(originOf('HTTPS://Nexus.VibeShiftAI.com:443/inbox?x=1')).toBe(ORIGIN);
+    expect(originOf('http://192.168.86.10:4000/')).toBe('http://192.168.86.10:4000');
+    expect(originOf('http://mac.local:80/x')).toBe('http://mac.local');
+    expect(hostOf('https://nexus.vibeshiftai.com:8443/x')).toBe('nexus.vibeshiftai.com');
+    expect(hostOf('http://[::1]:4000/')).toBe('[::1]');
+  });
+
+  it('rejects non-http URLs and userinfo spoofs', () => {
+    expect(originOf('javascript:alert(1)')).toBeNull();
+    expect(originOf('nexus://inbox')).toBeNull();
+    expect(originOf('https://nexus.vibeshiftai.com@evil.example/')).toBeNull();
+    expect(originOf('https://evil.example\\@nexus.vibeshiftai.com/')).toBe('https://evil.example');
+    expect(originOf(null)).toBeNull();
+    expect(hostOf('')).toBeNull();
+  });
+});
+
+describe('classifyNavigation', () => {
+  it('renders only the configured origin', () => {
+    expect(classifyNavigation(`${ORIGIN}/task/abc`, ORIGIN)).toBe('trusted');
+    expect(classifyNavigation('https://nexus.vibeshiftai.com.evil.example/', ORIGIN)).toBe('external');
+    expect(classifyNavigation('http://nexus.vibeshiftai.com/', ORIGIN)).toBe('external');
+    expect(classifyNavigation('https://github.com/x', ORIGIN)).toBe('external');
+  });
+
+  it('recognises the Cloudflare Access login and hands off phone/mail links', () => {
+    expect(classifyNavigation('https://vibeshiftai.cloudflareaccess.com/cdn-cgi/access/login/x', ORIGIN)).toBe('access-login');
+    expect(classifyNavigation('https://cloudflareaccess.com.evil.example/', ORIGIN)).toBe('external');
+    expect(classifyNavigation('mailto:robert@example.com', ORIGIN)).toBe('handoff');
+    expect(classifyNavigation('tel:+15551234567', ORIGIN)).toBe('handoff');
+  });
+
+  it('blocks every other scheme', () => {
+    for (const url of ['javascript:alert(1)', 'data:text/html,hi', 'intent://x#Intent;end', 'file:///etc/passwd', 'blob:https://x/y', 'about:blank']) {
+      expect(classifyNavigation(url, ORIGIN)).toBe('blocked');
+    }
+  });
+});
+
+describe('sanitizeDashboardPath', () => {
+  it('keeps same-origin paths with query and hash', () => {
+    expect(sanitizeDashboardPath('/inbox#hitl-1')).toBe('/inbox#hitl-1');
+    expect(sanitizeDashboardPath('/activity?channel=vault')).toBe('/activity?channel=vault');
+    expect(sanitizeDashboardPath('  /task/abc  ')).toBe('/task/abc');
+  });
+
+  it('collapses anything that could leave the origin', () => {
+    expect(sanitizeDashboardPath('https://evil.example/')).toBe('/');
+    expect(sanitizeDashboardPath('//evil.example/x')).toBe('/');
+    expect(sanitizeDashboardPath('/\\evil.example')).toBe('/');
+    expect(sanitizeDashboardPath('/inbox\nX')).toBe('/');
+    expect(sanitizeDashboardPath('inbox')).toBe('/');
+    expect(sanitizeDashboardPath(42)).toBe('/');
+    expect(sanitizeDashboardPath(undefined)).toBe('/');
+    expect(sanitizeDashboardPath(`/${'a'.repeat(3000)}`)).toBe('/');
+  });
+
+  it('percent-encodes raw spaces and non-ASCII without double-encoding', () => {
+    expect(sanitizeDashboardPath('/search?q=a b')).toBe('/search?q=a%20b');
+    expect(sanitizeDashboardPath('/search?q=a%20b')).toBe('/search?q=a%20b');
+    expect(sanitizeDashboardPath('/p/é')).toBe('/p/%C3%A9');
+  });
+});
+
+describe('dashboardPathForNativeRoute', () => {
+  it('maps the retired native screens onto dashboard routes', () => {
+    expect(stripRouteGroups('/(tabs)/inbox')).toBe('/inbox');
+    expect(stripRouteGroups('/(tabs)')).toBe('/');
+    expect(dashboardPathForNativeRoute('/(tabs)')).toBe('/');
+    expect(dashboardPathForNativeRoute('/(tabs)/tasks')).toBe('/task-board');
+    expect(dashboardPathForNativeRoute('/(tabs)/praxis')).toBe('/');
+    expect(dashboardPathForNativeRoute('/(tabs)/system')).toBe('/system-monitor');
+    expect(dashboardPathForNativeRoute('/dispatch')).toBe('/ops');
+    expect(dashboardPathForNativeRoute('/reports')).toBe('/activity');
+    expect(dashboardPathForNativeRoute('/report/2026-09-06.md')).toBe('/activity');
+    expect(dashboardPathForNativeRoute('/council/')).toBe('/council');
+  });
+
+  it('carries the HITL id into the inbox hash deep link', () => {
+    expect(dashboardPathForNativeRoute('/(tabs)/inbox', { hitlId: 'h 1' })).toBe('/inbox#h%201');
+    expect(dashboardPathForNativeRoute('/inbox', { hitlId: ['', 'h2'] })).toBe('/inbox#h2');
+    expect(dashboardPathForNativeRoute('/inbox')).toBe('/inbox');
+  });
+
+  it('passes task, project and unknown dashboard routes through', () => {
+    expect(dashboardPathForNativeRoute('/task/abc-123')).toBe('/task/abc-123');
+    expect(dashboardPathForNativeRoute('/project/p1')).toBe('/project/p1');
+    expect(dashboardPathForNativeRoute('/model-control')).toBe('/model-control');
+    expect(dashboardPathForNativeRoute('https://evil.example/')).toBe('/');
+  });
+});
+
+describe('shellHrefForNativeRoute', () => {
+  it('builds a /shell href with a nonce', () => {
+    expect(shellHrefForNativeRoute('/(tabs)/inbox', { hitlId: 'h1' }, 7)).toEqual({
+      pathname: '/shell',
+      params: { path: '/inbox#h1', n: '7' },
+    });
+    const { params } = shellHrefForNativeRoute('/(tabs)/praxis');
+    expect(params.path).toBe('/');
+    expect(params.n).toMatch(/^\d+$/);
+  });
+});
+
+describe('rewriteSystemPath', () => {
+  it('rewrites nexus:// links minted for the old screens', () => {
+    expect(rewriteSystemPath('nexus://inbox?hitlId=h1')).toBe('nexus://shell?path=%2Finbox%23h1');
+    expect(rewriteSystemPath('nexus://tasks')).toBe('nexus://shell?path=%2Ftask-board');
+    expect(rewriteSystemPath('nexus://')).toBe('nexus://shell?path=%2F');
+    expect(rewriteSystemPath('nexus://task/abc')).toBe('nexus://shell?path=%2Ftask%2Fabc');
+  });
+
+  it('keeps query strings and hashes for routes the dashboard owns', () => {
+    expect(rewriteSystemPath('nexus://activity?channel=vault')).toBe('nexus://shell?path=%2Factivity%3Fchannel%3Dvault');
+    expect(rewriteSystemPath('nexus://inbox#h2')).toBe('nexus://shell?path=%2Finbox%23h2');
+    expect(rewriteSystemPath('https://nexus.vibeshiftai.com/task/abc?tab=qa')).toBe('nexus://shell?path=%2Ftask%2Fabc%3Ftab%3Dqa');
+  });
+
+  it('leaves settings, shell, dev-client and Expo Go links alone', () => {
+    expect(rewriteSystemPath('nexus://settings')).toBe('nexus://settings');
+    expect(rewriteSystemPath('nexus://shell?path=%2Fops')).toBe('nexus://shell?path=%2Fops');
+    expect(rewriteSystemPath('exp+nexus-mobile://expo-development-client/?url=http%3A%2F%2F10.0.0.2%3A8081')).toBe(
+      'exp+nexus-mobile://expo-development-client/?url=http%3A%2F%2F10.0.0.2%3A8081',
+    );
+    expect(rewriteSystemPath('exp://10.0.0.2:8081/--/inbox')).toBe('exp://10.0.0.2:8081/--/inbox');
+  });
+
+  it('never lets a link pick a different origin', () => {
+    expect(rewriteSystemPath('nexus://https://evil.example/')).toBe('nexus://shell?path=%2F');
+    expect(rewriteSystemPath('nexus:////evil.example/')).toBe('nexus://shell?path=%2F');
+  });
+});
