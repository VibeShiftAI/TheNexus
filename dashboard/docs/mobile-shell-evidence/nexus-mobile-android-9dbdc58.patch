+import { buildBootstrapScript, buildNavigateScript, NAVIGATE_EVENT, parseShellMessage, SHELL_GLOBAL } from './bridge';
+
+describe('parseShellMessage', () => {
+  it('accepts every message on the contract, sanitising its payload', () => {
+    expect(parseShellMessage(JSON.stringify({ type: 'ready', path: '/inbox' }))).toEqual({ type: 'ready', path: '/inbox' });
+    expect(parseShellMessage(JSON.stringify({ type: 'navigated', path: 'https://evil.example' }))).toEqual({ type: 'navigated', path: '/' });
+    expect(parseShellMessage(JSON.stringify({ type: 'open-external', url: 'https://github.com/x' }))).toEqual({
+      type: 'open-external',
+      url: 'https://github.com/x',
+    });
+    expect(parseShellMessage(JSON.stringify({ type: 'open-settings' }))).toEqual({ type: 'open-settings' });
+    expect(parseShellMessage(JSON.stringify({ type: 'reload', extra: 1 }))).toEqual({ type: 'reload' });
+    expect(parseShellMessage(JSON.stringify({ type: 'badge', count: 3 }))).toEqual({ type: 'badge', count: 3 });
+    expect(parseShellMessage(JSON.stringify({ type: 'haptic', style: 'success' }))).toEqual({ type: 'haptic', style: 'success' });
+    expect(parseShellMessage(JSON.stringify({ type: 'haptic', style: 'nuke' }))).toEqual({ type: 'haptic', style: 'light' });
+  });
+
+  it('rejects anything off the contract', () => {
+    expect(parseShellMessage('')).toBeNull();
+    expect(parseShellMessage('not json')).toBeNull();
+    expect(parseShellMessage('[]')).toBeNull();
+    expect(parseShellMessage('null')).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'eval', code: '1' }))).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'open-external', url: 'javascript:alert(1)' }))).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'open-external', url: 'intent://x' }))).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'badge', count: -1 }))).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'badge', count: 1.5 }))).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'badge', count: '3' }))).toBeNull();
+    expect(parseShellMessage(JSON.stringify({ type: 'ready', path: 'x'.repeat(10_000) }))).toBeNull();
+    expect(parseShellMessage(42)).toBeNull();
+  });
+});
+
+type FakeWindow = Record<string, unknown> & { location: { origin: string } };
+
+function runBootstrap(script: string, origin: string) {
+  const window: FakeWindow = { location: { origin } };
+  const documentElement = { attrs: {} as Record<string, string>, setAttribute(k: string, v: string) { this.attrs[k] = v; } };
+  const document = { documentElement };
+  // eslint-disable-next-line no-new-func
+  new Function('window', 'document', script)(window, document);
+  return { window, documentElement };
+}
+
+describe('buildBootstrapScript', () => {
+  const script = buildBootstrapScript({ origin: 'https://nexus.vibeshiftai.com', platform: 'android', appVersion: '0.6.0' });
+
+  it('defines a frozen shell global only on the trusted origin', () => {
+    const { window, documentElement } = runBootstrap(script, 'https://nexus.vibeshiftai.com');
+    const shell = window[SHELL_GLOBAL] as Record<string, unknown>;
+    expect(shell).toMatchObject({ platform: 'android', appVersion: '0.6.0', origin: 'https://nexus.vibeshiftai.com', navigateEvent: NAVIGATE_EVENT });
+    expect(Object.isFrozen(shell)).toBe(true);
+    expect(Object.getOwnPropertyDescriptor(window, SHELL_GLOBAL)).toMatchObject({ writable: false, configurable: false });
+    expect(documentElement.attrs['data-nexus-shell']).toBe('android');
+  });
+
+  it('defines nothing anywhere else', () => {
+    const { window, documentElement } = runBootstrap(script, 'https://vibeshiftai.cloudflareaccess.com');
+    expect(window[SHELL_GLOBAL]).toBeUndefined();
+    expect(documentElement.attrs['data-nexus-shell']).toBeUndefined();
+  });
+
+  it('carries no secrets', () => {
+    expect(script).not.toMatch(/CF-Access|Bearer|secret|token/i);
+  });
+});
+
+describe('buildNavigateScript', () => {
+  it('dispatches the navigate event with a sanitised path', () => {
+    const script = buildNavigateScript('https://evil.example/x');
+    expect(script).toContain(NAVIGATE_EVENT);
+    expect(script).toContain('detail: "/"');
+    expect(buildNavigateScript('/task/abc#qa')).toContain('detail: "/task/abc#qa"');
+  });
+});
