+    view.rerender(<DashboardShell path="/task/abc" nonce="2" />);
+
+    expect(mockInject).toHaveBeenCalledTimes(1);
+    expect(mockInject.mock.calls[0][0]).toContain('nexus-mobile-navigate');
+    expect(mockInject.mock.calls[0][0]).toContain('"/task/abc"');
+    expect(mockCaptured.props!.source).toEqual({ uri: `${ORIGIN}/` });
+
+    view.rerender(<DashboardShell path="/task/abc" nonce="2" />);
+    expect(mockInject).toHaveBeenCalledTimes(1);
+  });
+
+  it('explains a refused token and lets the user retry or sign in', async () => {
+    mockPrime.mockResolvedValue({ ok: false, reason: 'access-denied', detail: 'nexus.example refused the credentials (HTTP 403).', status: 403 });
+    render(<DashboardShell path="/" />);
+
+    await screen.findByTestId('shell-overlay-failed');
+    expect(screen.getByText('Cloudflare Access refused the connection')).toBeTruthy();
+    expect(screen.getByText('nexus.example refused the credentials (HTTP 403).')).toBeTruthy();
+    expect(screen.queryByTestId('dashboard-webview')).toBeNull();
+
+    fireEvent.press(screen.getByTestId('shell-retry'));
+    await waitFor(() => expect(mockPrime).toHaveBeenCalledTimes(2));
+
+    fireEvent.press(screen.getByTestId('shell-settings'));
+    expect(mockPush).toHaveBeenCalledWith('/settings');
+
+    fireEvent.press(screen.getByTestId('shell-login'));
+    await screen.findByTestId('dashboard-webview');
+    expect(mockCaptured.props!.source).toEqual({ uri: `${ORIGIN}/` });
+  });
+
+  it('shows an unreachable server without a sign-in option', async () => {
+    mockPrime.mockResolvedValue({ ok: false, reason: 'unreachable', detail: 'Could not reach nexus.example: Network request failed' });
+    render(<DashboardShell path="/" />);
+    await screen.findByTestId('shell-overlay-failed');
+    expect(screen.getByText('nexus.example is unreachable')).toBeTruthy();
+    expect(screen.queryByTestId('shell-login')).toBeNull();
+    expect(screen.getByTestId('shell-retry')).toBeTruthy();
+  });
+
+  it('surfaces a page load failure over the WebView with a retry', async () => {
+    mockPrime.mockResolvedValue({ ok: true, host: 'nexus.example' });
+    render(<DashboardShell path="/" />);
+    await screen.findByTestId('dashboard-webview');
+
+    act(() => {
