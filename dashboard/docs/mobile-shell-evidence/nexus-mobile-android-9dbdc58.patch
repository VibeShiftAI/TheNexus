+jest.mock('@/lib/shell/session', () => ({ primeDashboardSession: (...args: unknown[]) => mockPrime(...args) }));
+jest.mock('expo-router', () => ({
+  useRouter: () => ({ push: mockPush, navigate: jest.fn(), replace: jest.fn(), canGoBack: () => false }),
+  useFocusEffect: (effect: () => undefined | (() => void)) => {
+    require('react').useEffect(effect, [effect]);
+  },
