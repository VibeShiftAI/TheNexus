+import { HEALTH_PATH, primeDashboardSession } from './session';
+
+jest.mock('@/lib/auth', () => ({
+  getMediaAuthHeaders: jest.fn(async () => ({ 'CF-Access-Client-Id': 'id', 'CF-Access-Client-Secret': 'secret' })),
+}));
+
+function response(init: { status?: number; url?: string; contentType?: string }) {
+  const status = init.status ?? 200;
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    url: init.url ?? 'https://nexus.vibeshiftai.com/api/health',
+    headers: { get: (name: string) => (name.toLowerCase() === 'content-type' ? init.contentType ?? null : null) },
+  };
+}
+
+describe('primeDashboardSession', () => {
+  const fetchMock = jest.fn();
+  beforeEach(() => {
+    fetchMock.mockReset();
+    global.fetch = fetchMock as unknown as typeof fetch;
+  });
+
+  it('sends the Access service-token headers to the API health endpoint', async () => {
+    fetchMock.mockResolvedValue(response({ contentType: 'application/json; charset=utf-8' }));
+    const result = await primeDashboardSession('https://nexus.vibeshiftai.com/');
+    expect(result).toEqual({ ok: true, host: 'nexus.vibeshiftai.com' });
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(url).toBe(`https://nexus.vibeshiftai.com${HEALTH_PATH}`);
+    expect(init.headers).toMatchObject({ 'CF-Access-Client-Id': 'id', 'CF-Access-Client-Secret': 'secret', Accept: 'application/json' });
+    expect(init.signal).toBeDefined();
+  });
+
+  it('reports access-denied when Access bounces to its login page', async () => {
+    fetchMock.mockResolvedValue(
+      response({ url: 'https://vibeshiftai.cloudflareaccess.com/cdn-cgi/access/login/nexus.vibeshiftai.com?x', contentType: 'text/html' }),
+    );
+    const result = await primeDashboardSession('https://nexus.vibeshiftai.com');
+    expect(result).toMatchObject({ ok: false, reason: 'access-denied' });
+  });
+
+  it('reports access-denied for 401/403 and for an HTML answer where JSON was expected', async () => {
+    fetchMock.mockResolvedValueOnce(response({ status: 403 }));
+    expect(await primeDashboardSession('https://nexus.vibeshiftai.com')).toMatchObject({ ok: false, reason: 'access-denied', status: 403 });
+    fetchMock.mockResolvedValueOnce(response({ contentType: 'text/html' }));
+    expect(await primeDashboardSession('https://nexus.vibeshiftai.com')).toMatchObject({ ok: false, reason: 'access-denied' });
+  });
+
+  it('reports server-error for 5xx and unreachable for network failures', async () => {
+    fetchMock.mockResolvedValueOnce(response({ status: 502, contentType: 'text/html' }));
+    expect(await primeDashboardSession('https://nexus.vibeshiftai.com')).toMatchObject({ ok: false, reason: 'server-error', status: 502 });
+    fetchMock.mockRejectedValueOnce(new TypeError('Network request failed'));
+    expect(await primeDashboardSession('https://nexus.vibeshiftai.com')).toMatchObject({ ok: false, reason: 'unreachable' });
+  });
+
+  it('reports not-configured without touching the network', async () => {
+    expect(await primeDashboardSession(null)).toMatchObject({ ok: false, reason: 'not-configured' });
+    expect(await primeDashboardSession('nexus://x')).toMatchObject({ ok: false, reason: 'not-configured' });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('gives up after the timeout', async () => {
+    jest.useFakeTimers();
+    try {
+      fetchMock.mockImplementation((_url: string, init: { signal: AbortSignal }) =>
+        new Promise((_resolve, reject) => {
+          init.signal.addEventListener('abort', () => {
+            const error = new Error('Aborted');
+            error.name = 'AbortError';
+            reject(error);
+          });
+        }),
+      );
+      const pending = primeDashboardSession('https://nexus.vibeshiftai.com', 50);
+      await jest.advanceTimersByTimeAsync(60);
+      expect(await pending).toMatchObject({ ok: false, reason: 'unreachable', detail: expect.stringContaining('did not answer') });
+    } finally {
+      jest.useRealTimers();
+    }
+  });
+});
