+import { render, screen } from '@testing-library/react-native';
+import React from 'react';
+
+import LegacyTabsRedirect from '../app/(tabs)/_layout';
+
+const mockNavigate = jest.fn();
+const mockReplace = jest.fn();
+let mockCanGoBack = true;
+let mockPathname = '/(tabs)/inbox';
+let mockParams: Record<string, string> = {};
+
+jest.mock('expo-router', () => ({
+  useRouter: () => ({ navigate: mockNavigate, replace: mockReplace, canGoBack: () => mockCanGoBack }),
+  usePathname: () => mockPathname,
+  useGlobalSearchParams: () => mockParams,
+}));
+
+beforeEach(() => {
+  mockNavigate.mockClear();
+  mockReplace.mockClear();
+});
+
+describe('legacy (tabs) routes', () => {
+  it('pop back to the existing shell showing the equivalent dashboard page', () => {
+    mockCanGoBack = true;
+    mockPathname = '/(tabs)/inbox';
+    mockParams = { hitlId: 'h1' };
+    render(<LegacyTabsRedirect />);
+    expect(screen.getByTestId('legacy-tabs-redirect')).toBeTruthy();
+    expect(mockNavigate).toHaveBeenCalledWith({ pathname: '/shell', params: { path: '/inbox#h1', n: expect.any(String) } });
+    expect(mockReplace).not.toHaveBeenCalled();
+  });
+
+  it('replace themselves with the shell when nothing is below them', () => {
+    mockCanGoBack = false;
+    mockPathname = '/(tabs)/tasks';
+    mockParams = {};
+    render(<LegacyTabsRedirect />);
+    expect(mockReplace).toHaveBeenCalledWith({ pathname: '/shell', params: { path: '/task-board', n: expect.any(String) } });
+    expect(mockNavigate).not.toHaveBeenCalled();
+  });
+});
