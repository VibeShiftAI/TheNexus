@@ -0,0 +1,600 @@
+/**
+ * DashboardShell — the app, in one screen: a WebView showing the canonical
+ * Nexus dashboard at the configured server URL, plus the native pieces a
+ * browser tab cannot provide — Cloudflare Access session priming, Android
+ * back, push-notification routing, safe areas, and honest loading / failure /
+ * retry states. Design and acceptance mapping: docs/dashboard-shell.md.
+ *
+ * Trust boundary. Only the configured origin is rendered in this WebView (the
+ * Cloudflare Access login page is allowed as an explicit, user-chosen
+ * fallback). Every other http(s) URL opens in the system browser; mailto/tel
+ * go to their apps; every other scheme is refused. Bridge messages are
+ * honoured only when the sending frame is on the trusted origin, and the
+ * shell global is only defined on that origin. Credentials never cross into
+ * web content: the Access service token is used by ONE native fetch
+ * (lib/shell/session.ts) whose session cookie the WebView then carries.
+ */
+import Constants from 'expo-constants';
+import * as Haptics from 'expo-haptics';
+import * as Linking from 'expo-linking';
+import * as Notifications from 'expo-notifications';
+import { useFocusEffect, useRouter } from 'expo-router';
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { ActivityIndicator, AppState, BackHandler, Platform, Pressable, StyleSheet, Text, View } from 'react-native';
+import { SafeAreaView } from 'react-native-safe-area-context';
+import { WebView, type WebViewMessageEvent, type WebViewNavigation } from 'react-native-webview';
+import type {
+  ShouldStartLoadRequest,
+  WebViewErrorEvent,
+  WebViewHttpErrorEvent,
+  WebViewNavigationEvent,
+  WebViewProgressEvent,
+} from 'react-native-webview/lib/WebViewTypes';
+
+import { useAuth } from '@/components/auth-provider';
+import { getCfClientId, getCfClientSecret } from '@/lib/config';
+import { buildBootstrapScript, buildNavigateScript, parseShellMessage, type HapticStyle, type ShellMessage } from '@/lib/shell/bridge';
+import { classifyNavigation, hostOf, originOf, sanitizeDashboardPath } from '@/lib/shell/routes';
+import { primeDashboardSession, type PrimeResult } from '@/lib/shell/session';
+
+/** Matches the dashboard's `--background` so the first paint does not flash. */
+const DASHBOARD_BACKGROUND = '#020617';
+const ACCENT = '#22d3ee';
+const APP_VERSION = Constants.expoConfig?.version ?? '0.0.0';
+/** Appended to the WebView user agent so server logs and the dashboard can tell the shell apart. */
+export const USER_AGENT_SUFFIX = `NexusMobileShell/${APP_VERSION}`;
+/** Re-exchange the service token for a fresh Access cookie after this long since the last exchange. */
+const REPRIME_AFTER_MS = 6 * 60 * 60 * 1000;
+/** Silent re-primes allowed per page before the user is offered the interactive login instead. */
+const MAX_ACCESS_BOUNCES = 2;
+
+type PrimeFailure = Extract<PrimeResult, { ok: false }>;
+type SessionStatus = 'priming' | 'ready' | 'failed';
+type PageState = { status: 'loading' } | { status: 'ready' } | { status: 'error'; title: string; detail: string };
+
+export interface DashboardShellProps {
+  /** Dashboard path to show (already sanitized by the caller; sanitized again here). */
+  path: string;
+  /** Changes when the caller wants `path` applied again even if it did not change. */
+  nonce?: string;
+}
+
+function describeFailure(failure: PrimeFailure, host: string | null): { title: string; hint: string } {
+  const where = host ?? 'The server';
+  switch (failure.reason) {
+    case 'not-configured':
+      return {
+        title: 'Set up the connection',
+        hint: 'Enter the Nexus server URL and the Cloudflare Access service token in Connection settings.',
+      };
+    case 'access-denied':
+      return {
+        title: 'Cloudflare Access refused the connection',
+        hint: 'Check the CF-Access client ID and secret in Connection settings, or sign in with your Access identity instead.',
+      };
+    case 'unreachable':
+      return {
+        title: `${where} is unreachable`,
+        hint: "Check the phone's network and that the Cloudflare tunnel on the Mac is up, then retry.",
+      };
+    case 'server-error':
+      return {
+        title: `${where} returned an error`,
+        hint: 'The tunnel answered but the Nexus API did not. Retry, or check the API process on the Mac.',
+      };
+  }
+}
+
+async function triggerHaptic(style: HapticStyle): Promise<void> {
+  try {
+    if (style === 'success' || style === 'warning' || style === 'error') {
+      const type = {
+        success: Haptics.NotificationFeedbackType.Success,
+        warning: Haptics.NotificationFeedbackType.Warning,
+        error: Haptics.NotificationFeedbackType.Error,
+      }[style];
+      await Haptics.notificationAsync(type);
+    } else {
+      const impact = {
+        light: Haptics.ImpactFeedbackStyle.Light,
+        medium: Haptics.ImpactFeedbackStyle.Medium,
+        heavy: Haptics.ImpactFeedbackStyle.Heavy,
+      }[style];
+      await Haptics.impactAsync(impact);
+    }
+  } catch {
+    // Haptics are decoration; never let them surface as errors.
+  }
+}
+
+function openExternally(url: string): void {
+  Linking.openURL(url).catch(() => undefined);
+}
+
+function ShellButton({
+  label,
+  onPress,
+  primary = false,
+  testID,
+}: {
+  label: string;
+  onPress: () => void;
+  primary?: boolean;
+  testID?: string;
+}) {
+  return (
+    <Pressable
+      accessibilityRole="button"
+      testID={testID}
+      onPress={onPress}
+      style={({ pressed }) => [styles.button, primary && styles.buttonPrimary, pressed && styles.buttonPressed]}
+    >
+      <Text style={[styles.buttonLabel, primary && styles.buttonLabelPrimary]}>{label}</Text>
+    </Pressable>
+  );
+}
+
+export function DashboardShell({ path, nonce }: DashboardShellProps) {
+  const router = useRouter();
+  const { serverUrl } = useAuth();
+  const origin = useMemo(() => originOf(serverUrl), [serverUrl]);
+  const host = useMemo(() => hostOf(serverUrl), [serverUrl]);
+
+  const webRef = useRef<WebView>(null);
+  const [webKey, setWebKey] = useState(0);
+  const [sourceUri, setSourceUriState] = useState<string | null>(null);
+  const [session, setSession] = useState<SessionStatus>('priming');
+  const [failure, setFailure] = useState<PrimeFailure | null>(null);
+  const [interactiveLogin, setInteractiveLogin] = useState(false);
+  const [page, setPage] = useState<PageState>({ status: 'loading' });
+  const [firstPaint, setFirstPaint] = useState(false);
+  const [progress, setProgress] = useState(0);
+
+  const requestedPathRef = useRef(sanitizeDashboardPath(path));
+  requestedPathRef.current = sanitizeDashboardPath(path);
+  const appliedNonceRef = useRef<string | undefined>(nonce);
+  const sourceUriRef = useRef<string | null>(null);
+  const webReadyRef = useRef(false);
+  const canGoBackRef = useRef(false);
+  const bouncesRef = useRef(0);
+  const interactiveRef = useRef(false);
+  const hasTokenRef = useRef(false);
+  const lastPrimeAtRef = useRef(0);
+  const mainUrlRef = useRef<string | null>(null);
+  const aliveRef = useRef(true);
+
+  useEffect(() => {
+    aliveRef.current = true;
+    return () => {
+      aliveRef.current = false;
+    };
+  }, []);
+
+  const setSourceUri = useCallback((uri: string | null) => {
+    sourceUriRef.current = uri;
+    setSourceUriState(uri);
+  }, []);
+
+  const remountWeb = useCallback(() => {
+    webReadyRef.current = false;
+    canGoBackRef.current = false;
+    setFirstPaint(false);
+    setProgress(0);
+    setPage({ status: 'loading' });
+    setWebKey((k) => k + 1);
+  }, []);
+
+  const reloadPage = useCallback(() => {
+    setPage({ status: 'loading' });
+    if (webRef.current) webRef.current.reload();
+    else remountWeb();
+  }, [remountWeb]);
+
+  /** Exchange the stored service token for an Access cookie; true when the dashboard can load. */
+  const prime = useCallback(async (): Promise<boolean> => {
+    setSession('priming');
+    setFailure(null);
+    const [id, secret] = await Promise.all([getCfClientId(), getCfClientSecret()]);
+    hasTokenRef.current = Boolean(id && secret);
+    const result = await primeDashboardSession(serverUrl);
+    if (!aliveRef.current) return false;
+    if (result.ok) {
+      lastPrimeAtRef.current = Date.now();
+      setSession('ready');
+      return true;
+    }
+    setFailure(result);
+    setSession('failed');
+    return false;
+  }, [serverUrl]);
+
+  /** (Re)connect: prime, then point the WebView at the requested path (or refresh the page it has). */
+  const connect = useCallback(async () => {
+    if (!origin) return;
+    const ok = await prime();
+    if (!ok || !aliveRef.current) return;
+    if (sourceUriRef.current) {
+      reloadPage();
+    } else {
+      setSourceUri(`${origin}${requestedPathRef.current}`);
+    }
+  }, [origin, prime, reloadPage, setSourceUri]);
+
+  /** Last resort when the service token is not accepted: let Access run its own login in the WebView. */
+  const startInteractiveLogin = useCallback(() => {
+    if (!origin) return;
+    interactiveRef.current = true;
+    bouncesRef.current = 0;
+    setInteractiveLogin(true);
+    setFailure(null);
+    setSession('ready');
+    setSourceUri(`${origin}${requestedPathRef.current}`);
+    remountWeb();
+  }, [origin, remountWeb, setSourceUri]);
+
+  const retry = useCallback(() => {
+    if (session !== 'ready') {
+      void connect();
+      return;
+    }
+    reloadPage();
+  }, [session, connect, reloadPage]);
+
+  const openSettings = useCallback(() => {
+    router.push('/settings');
+  }, [router]);
+
+  // Origin (re)configured: reset everything and connect from scratch.
+  useEffect(() => {
+    bouncesRef.current = 0;
+    interactiveRef.current = false;
+    lastPrimeAtRef.current = 0;
+    setInteractiveLogin(false);
+    setSourceUri(null);
+    remountWeb();
+    if (!origin) {
+      setSession('failed');
+      setFailure({
+        ok: false,
+        reason: 'not-configured',
+        detail: serverUrl ? `"${serverUrl}" is not an http(s) URL.` : 'No Nexus server URL is configured.',
+      });
+      return;
+    }
+    void connect();
+  }, [origin, serverUrl, connect, remountWeb, setSourceUri]);
+
+  // A new navigation request (push tap, deep link, legacy route) while mounted.
+  useEffect(() => {
+    if (nonce === appliedNonceRef.current) return;
+    appliedNonceRef.current = nonce;
+    if (!origin) return;
+    const target = sanitizeDashboardPath(path);
+    if (webReadyRef.current && webRef.current) {
+      webRef.current.injectJavaScript(buildNavigateScript(target));
+    } else if (sourceUriRef.current) {
+      setSourceUri(`${origin}${target}`);
+    }
+    // Otherwise the first load has not started yet; connect() reads requestedPathRef when it does.
+  }, [path, nonce, origin, setSourceUri]);
+
+  // Coming back to the foreground: recover from failures, keep the Access cookie fresh.
+  useEffect(() => {
+    const subscription = AppState.addEventListener('change', (state) => {
+      if (state !== 'active' || !origin) return;
+      if (session === 'failed' && !interactiveRef.current) {
+        void connect();
+        return;
+      }
+      if (page.status === 'error') {
+        reloadPage();
+        return;
+      }
+      if (session === 'ready' && hasTokenRef.current && Date.now() - lastPrimeAtRef.current > REPRIME_AFTER_MS) {
+        void primeDashboardSession(serverUrl).then((result) => {
+          if (result.ok && aliveRef.current) lastPrimeAtRef.current = Date.now();
+        });
+      }
+    });
+    return () => subscription.remove();
+  }, [origin, serverUrl, session, page.status, connect, reloadPage]);
+
+  // Android back: walk the dashboard's history first; only when it is exhausted
+  // does the system get the press (which backgrounds the app). Registered only
+  // while this screen is focused so /settings on top keeps its own back.
+  useFocusEffect(
+    useCallback(() => {
+      if (Platform.OS !== 'android') return undefined;
+      const subscription = BackHandler.addEventListener('hardwareBackPress', () => {
+        if (canGoBackRef.current && webRef.current) {
+          webRef.current.goBack();
+          return true;
+        }
+        return false;
+      });
+      return () => subscription.remove();
+    }, []),
+  );
+
+  const handleMessage = useCallback(
+    (message: ShellMessage) => {
+      switch (message.type) {
+        case 'ready':
+          webReadyRef.current = true;
+          bouncesRef.current = 0;
+          setFirstPaint(true);
+          setPage((current) => (current.status === 'error' ? current : { status: 'ready' }));
+          break;
+        case 'navigated':
+          if (origin) mainUrlRef.current = `${origin}${message.path}`;
+          break;
+        case 'open-external':
+          openExternally(message.url);
+          break;
+        case 'open-settings':
+          openSettings();
+          break;
+        case 'badge':
+          Notifications.setBadgeCountAsync(message.count).catch(() => undefined);
+          break;
+        case 'haptic':
+          void triggerHaptic(message.style);
+          break;
+        case 'reload':
+          reloadPage();
+          break;
+      }
+    },
+    [origin, openSettings, reloadPage],
+  );
+
+  const onMessage = useCallback(
+    (event: WebViewMessageEvent) => {
+      if (!origin || originOf(event.nativeEvent.url) !== origin) return;
+      const message = parseShellMessage(event.nativeEvent.data);
+      if (message) handleMessage(message);
+    },
+    [origin, handleMessage],
+  );
+
+  const onShouldStartLoadWithRequest = useCallback(
+    (request: ShouldStartLoadRequest): boolean => {
+      if (!origin) return false;
+      const kind = classifyNavigation(request.url, origin);
+      if (kind === 'trusted') return true;
+      // Nothing off-origin is ever rendered inside a frame of the dashboard.
+      if (request.isTopFrame === false) return false;
+      if (kind === 'access-login') {
+        if (interactiveRef.current) return true;
+        if (hasTokenRef.current && bouncesRef.current < MAX_ACCESS_BOUNCES) {
+          // The session cookie expired or was rejected: exchange the token again, then retry the page.
+          bouncesRef.current += 1;
+          void primeDashboardSession(serverUrl).then((result) => {
+            if (!aliveRef.current) return;
+            if (result.ok) {
+              lastPrimeAtRef.current = Date.now();
+              reloadPage();
+            } else {
+              setFailure(result);
+              setSession('failed');
+            }
+          });
+          return false;
+        }
+        setFailure({
+          ok: false,
+          reason: 'access-denied',
+          detail: `${host ?? 'The server'} keeps sending the app to the Cloudflare Access login, so the service token is not being accepted.`,
+        });
+        setSession('failed');
+        return false;
+      }
+      if (kind === 'external' || kind === 'handoff') openExternally(request.url);
+      return false;
+    },
+    [origin, host, serverUrl, reloadPage],
+  );
+
+  const onNavigationStateChange = useCallback(
+    (navigation: WebViewNavigation) => {
+      canGoBackRef.current = navigation.canGoBack;
+      if (origin && originOf(navigation.url) === origin) mainUrlRef.current = navigation.url;
+    },
+    [origin],
+  );
+
+  const onLoadStart = useCallback((event: WebViewNavigationEvent) => {
+    mainUrlRef.current = event.nativeEvent.url;
+    webReadyRef.current = false;
+    setProgress(0);
+    setPage({ status: 'loading' });
+  }, []);
+
+  const onLoadEnd = useCallback(() => {
+    setProgress(1);
+    setFirstPaint(true);
+    setPage((current) => (current.status === 'error' ? current : { status: 'ready' }));
+  }, []);
+
+  const onLoadProgress = useCallback((event: WebViewProgressEvent) => {
+    setProgress(event.nativeEvent.progress);
+  }, []);
+
+  const onError = useCallback((event: WebViewErrorEvent) => {
+    const { description, code, url } = event.nativeEvent;
+    setPage({
+      status: 'error',
+      title: 'The dashboard failed to load',
+      detail: `${description || 'Unknown error'} (${code})${url ? ` — ${url}` : ''}`,
+    });
+  }, []);
+
+  const onHttpError = useCallback(
+    (event: WebViewHttpErrorEvent) => {
+      const { statusCode, url } = event.nativeEvent;
+      // Sub-resource failures are the dashboard's to report; only the page itself dying is ours.
+      if (statusCode < 500 || (mainUrlRef.current && url !== mainUrlRef.current)) return;
+      setPage({
+        status: 'error',
+        title: `${host ?? 'The server'} answered HTTP ${statusCode}`,
+        detail: 'The tunnel is up but the dashboard is failing. Retry, or check the Next.js process on the Mac.',
+      });
+    },
+    [host],
+  );
+
+  const bootstrap = useMemo(
+    () => (origin ? buildBootstrapScript({ origin, platform: Platform.OS, appVersion: APP_VERSION }) : undefined),
+    [origin],
+  );
+
+  if (Platform.OS === 'web') {
+    return (
+      <View style={[styles.root, styles.center]} testID="shell-web-notice">
+        <Text style={styles.title}>Nexus dashboard</Text>
+        <Text style={styles.detail}>On the web, the dashboard is the app. Open it directly.</Text>
+        {origin ? (
+          <ShellButton label={`Open ${origin}`} primary onPress={() => openExternally(`${origin}${requestedPathRef.current}`)} />
+        ) : null}
+      </View>
+    );
+  }
+
+  const showSessionOverlay = session !== 'ready';
+  const showPageOverlay = page.status === 'error' || (page.status === 'loading' && !firstPaint);
+
+  let overlay: React.ReactNode = null;
+  if (showSessionOverlay) {
+    if (session === 'priming' || !failure) {
+      overlay = (
+        <View style={styles.overlay} testID="shell-overlay-priming">
+          <ActivityIndicator size="large" color={ACCENT} />
+          <Text style={styles.title}>Connecting to {host ?? 'Nexus'}…</Text>
+          <Text style={styles.detail}>Exchanging the Cloudflare Access service token for a session.</Text>
+        </View>
+      );
+    } else {
+      const { title, hint } = describeFailure(failure, host);
+      overlay = (
+        <View style={styles.overlay} testID="shell-overlay-failed" accessibilityRole="alert">
+          <Text style={styles.kicker}>Connection</Text>
+          <Text style={styles.title}>{title}</Text>
+          <Text style={styles.detail}>{failure.detail}</Text>
+          <Text style={styles.hint}>{hint}</Text>
+          <View style={styles.actions}>
+            {failure.reason !== 'not-configured' ? <ShellButton label="Retry" primary onPress={retry} testID="shell-retry" /> : null}
+            {failure.reason === 'access-denied' ? (
+              <ShellButton label="Sign in with Cloudflare Access" onPress={startInteractiveLogin} testID="shell-login" />
+            ) : null}
+            <ShellButton label="Connection settings" onPress={openSettings} testID="shell-settings" />
+          </View>
+        </View>
+      );
+    }
+  } else if (showPageOverlay) {
+    overlay =
+      page.status === 'error' ? (
+        <View style={styles.overlay} testID="shell-overlay-page-error" accessibilityRole="alert">
+          <Text style={styles.kicker}>Dashboard</Text>
+          <Text style={styles.title}>{page.title}</Text>
+          <Text style={styles.detail}>{page.detail}</Text>
+          <View style={styles.actions}>
+            <ShellButton label="Retry" primary onPress={retry} testID="shell-retry" />
+            <ShellButton label="Connection settings" onPress={openSettings} testID="shell-settings" />
+          </View>
+        </View>
+      ) : (
+        <View style={styles.overlay} testID="shell-overlay-loading">
+          <ActivityIndicator size="large" color={ACCENT} />
+          <Text style={styles.title}>Loading the dashboard…</Text>
+          <Text style={styles.detail}>{interactiveLogin ? 'Cloudflare Access sign-in' : host ?? ''}</Text>
+        </View>
+      );
+  }
+
+  return (
+    <SafeAreaView style={styles.root} edges={['top', 'right', 'bottom', 'left']}>
+      {sourceUri ? (
+        <WebView
+          key={webKey}
+          ref={webRef}
+          testID="dashboard-webview"
+          style={styles.web}
+          containerStyle={styles.web}
+          source={{ uri: sourceUri }}
+          originWhitelist={['*']}
+          onShouldStartLoadWithRequest={onShouldStartLoadWithRequest}
+          onMessage={onMessage}
+          onNavigationStateChange={onNavigationStateChange}
+          onLoadStart={onLoadStart}
+          onLoadEnd={onLoadEnd}
+          onLoadProgress={onLoadProgress}
+          onError={onError}
+          onHttpError={onHttpError}
+          onRenderProcessGone={remountWeb}
+          onContentProcessDidTerminate={remountWeb}
+          injectedJavaScriptBeforeContentLoaded={bootstrap}
+          injectedJavaScriptBeforeContentLoadedForMainFrameOnly
+          injectedJavaScriptForMainFrameOnly
+          javaScriptEnabled
+          domStorageEnabled
+          sharedCookiesEnabled
+          thirdPartyCookiesEnabled={false}
+          setSupportMultipleWindows={false}
+          allowFileAccess={false}
+          allowFileAccessFromFileURLs={false}
+          allowUniversalAccessFromFileURLs={false}
+          allowsInlineMediaPlayback
+          mediaPlaybackRequiresUserAction={false}
+          mediaCapturePermissionGrantType="grantIfSameHostElseDeny"
+          applicationNameForUserAgent={USER_AGENT_SUFFIX}
+          overScrollMode="never"
+          setBuiltInZoomControls={false}
+          cacheEnabled
