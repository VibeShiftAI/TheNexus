index 0000000..ef24eb7
--- /dev/null
+++ b/lib/shell/bridge.ts
@@ -0,0 +1,125 @@
+/**
+ * Dashboard shell — the native ↔ web bridge contract.
+ *
+ * Web → native: the dashboard calls window.ReactNativeWebView.postMessage(JSON)
+ * with one of the shapes in ShellMessage. The shell honours a message only
+ * when the frame that sent it is on the trusted origin (checked natively from
+ * the event's URL, not from anything the page says), and only these types.
+ *
+ * Native → web: before the document runs, the shell defines a frozen
+ * window.__NEXUS_MOBILE_SHELL__ — main frame only, and self-guarded so it only
+ * ever exists on the trusted origin — and later dispatches
+ * `nexus-mobile-navigate` CustomEvents carrying a dashboard path.
+ *
+ * No credential, token, or server address the page does not already know
+ * crosses this bridge in either direction.
+ */
+import { sanitizeDashboardPath } from './routes';
+
+export const SHELL_GLOBAL = '__NEXUS_MOBILE_SHELL__';
+export const NAVIGATE_EVENT = 'nexus-mobile-navigate';
+export const SHELL_CAPABILITIES = ['navigate', 'open-external', 'open-settings', 'badge', 'haptic', 'reload'] as const;
+
+export type HapticStyle = 'light' | 'medium' | 'heavy' | 'success' | 'warning' | 'error';
+
+export type ShellMessage =
+  /** The dashboard has mounted its shell bridge; `path` is its current location. */
+  | { type: 'ready'; path: string }
+  /** Client-side route change inside the dashboard. */
+  | { type: 'navigated'; path: string }
+  /** Open an http(s) URL in the system browser. */
+  | { type: 'open-external'; url: string }
+  /** Open the native connection settings screen. */
+  | { type: 'open-settings' }
+  /** Set the launcher badge (0 clears it). */
+  | { type: 'badge'; count: number }
+  | { type: 'haptic'; style: HapticStyle }
+  /** Reload the current page (e.g. the dashboard's own "reload the deck" affordance). */
+  | { type: 'reload' };
+
+const MAX_MESSAGE_CHARS = 8 * 1024;
+const MAX_URL_CHARS = 2048;
+const HAPTIC_STYLES: ReadonlySet<string> = new Set(['light', 'medium', 'heavy', 'success', 'warning', 'error']);
+
+/** Parse and validate a raw postMessage payload; null for anything off-contract. */
+export function parseShellMessage(raw: unknown): ShellMessage | null {
+  if (typeof raw !== 'string' || raw.length === 0 || raw.length > MAX_MESSAGE_CHARS) return null;
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return null;
+  const msg = parsed as Record<string, unknown>;
+  switch (msg.type) {
+    case 'ready':
+    case 'navigated':
+      return { type: msg.type, path: sanitizeDashboardPath(msg.path) };
+    case 'open-external': {
+      if (typeof msg.url !== 'string' || msg.url.length > MAX_URL_CHARS || !/^https?:\/\/[^\s]+$/i.test(msg.url)) return null;
+      return { type: 'open-external', url: msg.url };
+    }
+    case 'open-settings':
+      return { type: 'open-settings' };
+    case 'reload':
+      return { type: 'reload' };
+    case 'badge': {
+      const count = typeof msg.count === 'number' && Number.isInteger(msg.count) ? msg.count : NaN;
+      if (!(count >= 0 && count <= 999)) return null;
+      return { type: 'badge', count };
+    }
+    case 'haptic': {
+      const style = typeof msg.style === 'string' && HAPTIC_STYLES.has(msg.style) ? (msg.style as HapticStyle) : 'light';
+      return { type: 'haptic', style };
+    }
+    default:
+      return null;
+  }
+}
+
+export interface BootstrapOptions {
+  /** The one origin the shell trusts (`https://host`). */
+  origin: string;
+  platform: string;
+  appVersion: string;
+}
+
+/**
+ * JavaScript injected before the document runs (main frame only). It checks
+ * the page's own origin before defining anything, so a page from anywhere
+ * else — an Access login bounce, a link that slipped through — never sees the
+ * shell global. The global is frozen and non-configurable so page code cannot
+ * spoof a different capability set later.
+ */
+export function buildBootstrapScript(opts: BootstrapOptions): string {
+  const payload = JSON.stringify({
+    platform: opts.platform,
+    appVersion: opts.appVersion,
+    origin: opts.origin,
+    capabilities: SHELL_CAPABILITIES,
+    navigateEvent: NAVIGATE_EVENT,
+  });
+  return `(function () {
+  try {
+    var shell = ${payload};
+    if (!window.location || window.location.origin !== shell.origin) return;
+    if (!window[${JSON.stringify(SHELL_GLOBAL)}]) {
+      Object.defineProperty(window, ${JSON.stringify(SHELL_GLOBAL)}, {
+        value: Object.freeze(shell), writable: false, configurable: false, enumerable: true
+      });
+    }
+    if (document.documentElement) document.documentElement.setAttribute('data-nexus-shell', shell.platform);
+  } catch (e) {}
+})(); true;`;
+}
+
+/** JavaScript that asks the running dashboard to route to `path` client-side. */
+export function buildNavigateScript(path: string): string {
+  const detail = JSON.stringify(sanitizeDashboardPath(path));
+  return `(function () {
+  try {
+    window.dispatchEvent(new CustomEvent(${JSON.stringify(NAVIGATE_EVENT)}, { detail: ${detail} }));
+  } catch (e) {}
+})(); true;`;
+}
