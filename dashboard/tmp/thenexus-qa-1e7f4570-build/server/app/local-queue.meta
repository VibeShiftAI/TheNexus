{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/local-queue/layout,_N_T_/local-queue/page,_N_T_/local-queue"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/local-queue/__PAGE__",
    "/local-queue",
    "/_index",
    "/_head"
  ]
}